    pygame.Rect(800, 230, 90, 40)
]

#setup the game
clock = pygame.time.Clock()
running = True
won = False

#main game loop
while running:

    #check for event

    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False
    
    #check fot the key pressed
    keys = pygame.key.get_pressed()

    if not won:

        #setup gravity
        #for the player
        player_y += gravity #make the player go down
        player = pygame.Rect(player_x, player_y, player_w, player_h) #SETUP THE PLAYER

        #check fro the collision so player stop at the ground
        for decor in decors:
            if player.colliderect(decor):
                player_y -= player_speed # put a bigger speed for the player to make him walk
        for object in objects:
            if player.colliderect(object):
                player_y -= player_speed 
        #for the ennemies  
        # same but for two ennemies 
        ennemy1_y += gravity
        ennemy1 = pygame.Rect(ennemy1_x, ennemy1_y, ennemy1_size, ennemy1_size)
                        
        for decor in decors:
            if ennemy1.colliderect(decor):
                ennemy1_y -= ennemy1_speed + 2
        for object in objects:
            if ennemy1.colliderect(object):
                ennemy1_y -= ennemy1_speed + 2 #make the both speed the same so he just moove on the ground

        ennemy2_y += gravity
        ennemy2 = pygame.Rect(ennemy2_x, ennemy2_y, ennemy2_size, ennemy2_size)
                                
        for decor in decors:
            if ennemy2.colliderect(decor):
                ennemy2_y -= ennemy2_speed + 2
        for object in objects:
            if ennemy2.colliderect(object):
                ennemy2_y -= ennemy2_speed + 2
                        
        
                
        
                
        #setup the movement 
        #move left
        if keys[pygame.K_LEFT]:
            player_x -= player_speed #move the player to the left
            player = pygame.Rect(player_x, player_y, player_w, player_h) #define the player

            #check for tthe collisons
            for decor in decors:  #with the ground
                if player.colliderect(decor):
                    player_x += player_speed
            for object in objects:  #with the rocks
                if player.colliderect(object):
                    player_x += player_speed

        #move right
        if keys[pygame.K_RIGHT]:
            player_x += player_speed
            player = pygame.Rect(player_x, player_y, player_w, player_h)
            for decor in decors:
                if player.colliderect(decor):
                    player_x -= player_speed
            for object in objects:
                if player.colliderect(object):
                    player_x -= player_speed

        #move down
        if keys[pygame.K_DOWN]:
            player_y += player_speed
            player = pygame.Rect(player_x, player_y, player_w, player_h)
        
            for decor in decors:
                if player.colliderect(decor):
                    player_y -= player_speed
            for object in objects:
                if player.colliderect(object):
                    player_y -= player_speed
        
        #move up
        if keys[pygame.K_UP]:
            player_y -= player_speed
            player = pygame.Rect(player_x, player_y, player_w, player_h)
                
            for decor in decors:
                if player.colliderect(decor):
                    player_y += player_speed
            for object in objects:
                if player.colliderect(object):
                    player_y += player_speed
        
        
        #jump
        if keys[pygame.K_SPACE]:
            
            player = pygame.Rect(player_x, player_y, player_w, player_h) #setup the player
            #check if the player touch the ground so he can infint jump in the air
            for decor in decors:
                ground_dif = player_y - floor_h # calculate the distance between the player and the ground
                
                if ground_dif > 360 and ground_dif < 370: #check if the distamce is ok
                    
                    player_y = player_y - 100 #make the player jump

            #sam, vut for the objects
            for object in objects:
                if player_x >= 1000 and player_x <= 1050: #check if the player is on the frist object
                    object_dif = player_y - object_y #calculate the distance
                if player_x >= 500 and player_x <= 540:#check if the player is on the second object
                    object_dif = player_y - object_y
                if player_x >= 705 and player_x <= 745:#check if the player is on the third object
                    object_dif = player_y - object_y
                #print("player y =",player_y, "   object dif=", object_dif)
                if object_dif > -50 and object_dif < -35: #check if the distance is ok
                     
                    player_y = player_y - 100 #make the player 100 points higher to jump

        # setup the movement for the ennemies
        #if player to the left of the ennemy
        if player_x < ennemy1_x:
            ennemy1_x -= ennemy1_speed
            ennemy1 = pygame.Rect(ennemy1_x, ennemy1_y, ennemy1_size, ennemy1_size)
        #if player to the right of the ennemy
        if player_x > ennemy1_x:
            ennemy1_x += ennemy1_speed
            ennemy1 = pygame.Rect(ennemy1_x, ennemy1_y, ennemy1_size, ennemy1_size)
    #stop the ennemies and setup collision
    #if it s going to the left block the right size
        if player_x < ennemy1_x:
            for decor in decors:
                if ennemy1.colliderect(decor):
                    ennemy1_x += ennemy1_speed
            for object in objects:
                if ennemy1.colliderect(object):
                    ennemy1_x += ennemy1_speed
         #if it s going to the right block the left size
        if player_x > ennemy1_x:
            for decor in decors:
                if ennemy1.colliderect(decor):
                    ennemy1_x -= ennemy1_speed
            for object in objects:
                if ennemy1.colliderect(object):
                    ennemy1_x -= ennemy1_speed
        #same but for the second ennemy
        if player_x < ennemy2_x:
            ennemy2_x -= ennemy2_speed
            ennemy2 = pygame.Rect(ennemy2_x, ennemy2_y, ennemy2_size, ennemy2_size)
        if player_x > ennemy2_x:
            ennemy2_x += ennemy2_speed
            ennemy2 = pygame.Rect(ennemy2_x, ennemy2_y, ennemy2_size, ennemy2_size)
        if player_x < ennemy2_x:
            for decor in decors:
                if ennemy2.colliderect(decor):
                    ennemy2_x += ennemy2_speed
            for object in objects:
                if ennemy2.colliderect(object):
                    ennemy2_x += ennemy2_speed
        if player_x > ennemy2_x:
            for decor in decors:
                if ennemy2.colliderect(decor):
                    ennemy2_x -= ennemy2_speed
            for object in objects:
                if ennemy2.colliderect(object):
                    ennemy2_x -= ennemy2_speed
        


                          
        #setup border

        if player_x < 0:
            player_x = 0

        if player_x > screen_w - player_w:
            player_x = screen_w - player_w

        if player_y < 0:
            player_y = 0

        if player_y > screen_h - player_h:
            player_y = screen_h - player_h

        #update the position and the player, and the two ennemies
        player = pygame.Rect(player_x, player_y, player_w, player_h)
        ennemy1 = pygame.Rect(ennemy1_x, ennemy1_y, ennemy1_size, ennemy1_size)
        ennemy2 = pygame.Rect(ennemy2_x, ennemy2_y, ennemy2_size, ennemy2_size)

        #check if the player is at the exit to stop the game 
        if player.colliderect(exit_door):
            won = True

    #draw the sky
    screen.fill(SKY_BLUE)

    #Draw the decor, the ogject and the cloud with thte rights colors
    for decor in decors:
        pygame.draw.rect(screen, GREEN, decor)
    for object in objects:
        pygame.draw.rect(screen, BLACK, object)
    for cloud in clouds:
        pygame.draw.rect(screen, WHITE, cloud)


    #draw the exit
    pygame.draw.rect(screen, BROWN, exit_door)

    #draw the player in different part to have different colours
    player = pygame.Rect(player_x, player_y, player_w, player_h) #draw the top
    player_leg = pygame.Rect(player_x, player_y, player_w, player_h - 20) #draw the leg
    player_head = pygame.Rect(player_x, player_y - 15, player_w, player_h - 20) #draw the head
    pygame.draw.rect(screen, BLUE, player)
    pygame.draw.rect(screen, RED, player_leg )
    pygame.draw.rect(screen, SKIN, player_head )

    #draw the ennemies
    """"
    for event in pygame.event.get():
        if event.type == ennemy_spawn:
            print("eeee")
            pygame.draw.rect(screen, BROWN, ennemy1)
            pygame.draw.rect(screen, BROWN, ennemy2)
    """
    #win message
    if won:
        font = pygame.font.SysFont(None, 48)
        message = font.render("WINNNN!", True, BLACK)
        screen.blit(message, (1000,500))

    #update display
    pygame.display.flip()

    #limit the game to 60 fps
    clock.tick(60)

    #close the game if fall
    if player_y > 950:
        running = False

    if player.colliderect(ennemy1):
        running = False
    if player.colliderect(ennemy2):
        running = False


#close 
pygame.quit()
        

