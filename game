decors = [
    pygame.Rect(0, 700, 700, floor_h), #floor
    pygame.Rect(800, 700, 500, floor_h), #floor
    pygame.Rect(1800, 700, 200, floor_h)
]
#create the object and obstacles
#define the different size
object1_h = 60 
object2_h = 70
object3_h = 10
object4_h = 10
object_y = 640 #setup the high
#creat a list with all the variables
objects = [
    pygame.Rect(1000, object_y, 50, object1_h), #rock
    pygame.Rect(500, object_y - 10, 40, object2_h),
    pygame.Rect(705, object_y, 40, object3_h),
    pygame.Rect(1300, object_y - 20, 50, object4_h),
    pygame.Rect(1450, object_y - 30, 50, object4_h),
    pygame.Rect(1450, object_y - 110, 50, object4_h),
